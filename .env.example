AXIOM_DATABASE_PATH=data/axiom.db
AXIOM_TRADING_MODE=paper
# demo runs without credentials; alpaca reads real market data, still paper-only.
AXIOM_DATA_MODE=demo
AXIOM_INITIAL_CASH=100000
AXIOM_BOOTSTRAP_DEMO=true
AXIOM_POLL_SECONDS=300
# Credentials stay on the server. Never put them in frontend JavaScript.
AXIOM_ALPACA_KEY=
AXIOM_ALPACA_SECRET=
AXIOM_ALPACA_FEED=iex
# Optional for local use. Set this before exposing behind a secured reverse proxy.
AXIOM_API_TOKEN=
